# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/shatha_events

# JWT secrets - must be at least 32 characters long. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32-chars-min

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Server
PORT=4000
NODE_ENV=development

# The origin of the Next.js frontend - required for CORS + cookie scoping
CLIENT_URL=http://localhost:3000

# File storage: "local" saves to apps/api/uploads and serves them statically;
# "cloudinary" requires the three CLOUDINARY_* vars below.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email: "console" logs to stdout and appends to apps/api/.email-log.txt;
# "resend" sends real email via the Resend API and requires RESEND_API_KEY;
# "gmail" sends real email via your Gmail account and requires GMAIL_USER +
# GMAIL_APP_PASSWORD. The app password is NOT your real Gmail password - with
# 2-Step Verification turned on, generate a 16-character one at
# https://myaccount.google.com/apppasswords and use that instead.
EMAIL_DRIVER=console
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
