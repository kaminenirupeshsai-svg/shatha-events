{
  "name": "shatha-events",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"pnpm --filter @app/api dev\" \"pnpm --filter @app/web dev\"",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/api build && pnpm --filter @app/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @app/api seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
